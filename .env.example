# PLANTILLA. No pongas aqui valores reales: este fichero SI se sube a git.
#
# Copia este fichero a .env y rellena los valores ahi. El .env esta en
# .gitignore y nunca se sube.
#
#     copy .env.example .env

# Webhook de Discord: Ajustes del canal > Integraciones > Webhooks > Nuevo webhook
DISCORD_WEBHOOK_URL=

# Credenciales de la API de Blizzard: https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
